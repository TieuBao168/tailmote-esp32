# Target: ESP32 DOIT DevKit V1 (ESP32-WROOM-32, no PSRAM, 4 MB flash)
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# CPU / RAM
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_BT_ENABLED=n
CONFIG_SPIRAM=n
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# FreeRTOS stats for CPU% and stack high-water marks
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y

# Robustness
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# lwIP: esp_wireguard runs crypto inside the tcpip thread
# 5120 left only 660 B free under light tunnel load (run 1, 2026-11-24).
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=6144
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU1=y

# esp_wireguard 0.9.0 + IDF 5.x: the WireGuard netif keeps its device in netif->state.
# By default esp_netif also reads netif->state as its own esp_netif_t* in the lwIP
# ext-callback (netif_add -> netif_set_addr -> esp_netif_internal_dhcpc_cb) and
# panics (LoadProhibited) on the foreign netif. With the bridge option enabled IDF
# stores esp_netif in netif->client_data instead (LWIP_ESP_NETIF_DATA=1), so the
# WireGuard netif is ignored. The bridge itself is not used.
CONFIG_ESP_NETIF_BRIDGE_EN=y
CONFIG_LWIP_NUM_NETIF_CLIENT_DATA=1

# WireGuard component
CONFIG_WIREGUARD_ESP_NETIF=y
CONFIG_WIREGUARD_MAX_PEERS=1
CONFIG_WIREGUARD_x25519_IMPLEMENTATION_NACL=y
