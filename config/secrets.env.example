# =============================================================================
#  FORM CẤU HÌNH BÍ MẬT — esp32-tailscale / Phase 2 WireGuard PoC
# =============================================================================
#  Cách dùng (Linux/macOS: make <lệnh>   |   Windows: .	m <lệnh>):
#    make secrets          # tạo secrets/secrets.env từ form này (quyền 600)
#    <sửa secrets/secrets.env>
#    make config           # sinh khóa + cấu hình peer + sdkconfig.secrets
#
#  Quy tắc điền:
#    - Đặt giá trị trong dấu nháy đơn '...'. Nếu giá trị có dấu nháy đơn,
#      viết  '\''  (ví dụ:  'it'\''s'  ).
#    - Để trống '' = dùng giá trị tự động / mặc định ghi bên cạnh.
#    - File secrets/secrets.env KHÔNG được commit (đã có trong .gitignore).
# =============================================================================


# --- [1] Wi-Fi mà ESP32 kết nối (BẮT BUỘC) ----------------------------------
# Chỉ hỗ trợ 2.4 GHz. Mật khẩu để trống = mạng mở.
WIFI_SSID=''
WIFI_PASSWORD=''


# --- [2] Peer WireGuard (Linux: wg-quick | Windows: WireGuard for Windows) ---
# IP/hostname mà ESP32 dùng để tới máy peer (UDP).
# (Tên biến LINUX_* bên dưới giữ để tương thích; peer có thể là Windows.)
# Trống = tự lấy IP LAN hiện tại của máy chạy `make config`.
WG_ENDPOINT=''
# Cổng UDP WireGuard trên peer.                          Mặc định: 51820
WG_PORT='51820'


# --- [3] Địa chỉ trong tunnel -------------------------------------------------
LINUX_TUNNEL_IP='10.66.0.1'
ESP_TUNNEL_IP='10.66.0.2'
TUNNEL_NETMASK='255.255.255.0'
TUNNEL_PREFIX='24'


# --- [4] Khóa WireGuard (TÙY CHỌN) --------------------------------------------
# Trống = tự sinh (như `wg genkey`, không cần cài wg) và lưu vào secrets/*.key (giữ nguyên ở các
# lần chạy sau). Chỉ điền nếu muốn dùng khóa có sẵn (base64, 44 ký tự).
ESP_PRIVATE_KEY=''
LINUX_PRIVATE_KEY=''
# Preshared key tăng cường (tùy chọn). Điền 'auto' để tự sinh.
PRESHARED_KEY=''


# --- [5] Tham số tunnel ---------------------------------------------------------
# Persistent keepalive (giây, 0 = tắt).                  Mặc định: 25
WG_KEEPALIVE='25'
# Wi-Fi power save: 'none' (hiệu năng) | 'min_modem' (tiết kiệm điện)
WIFI_POWER_SAVE='none'


# --- [6] Máy build / nạp ----------------------------------------------------------
# Cổng serial của board (DOIT DevKit V1: CH340/CP2102), ví dụ /dev/ttyUSB0
# hoặc COM7. Trống = tự dò cổng USB-UART (CH34x/CP210x/FTDI/Espressif).
SERIAL_PORT=''
# Tốc độ nạp firmware.                                    Mặc định: 460800
FLASH_BAUD='460800'

# --- [7] Tailscale (Phase 3, firmware/phase3-tailscale) -----------------------
# Auth key tạo ở https://login.tailscale.com/admin/settings/keys
# (nên chọn Reusable + Pre-approved; Tags nếu tailnet dùng ACL theo tag).
# Trống = board in URL đăng nhập ra cổng serial để bạn mở và duyệt.
TS_AUTH_KEY=''
# Tên máy trên tailnet (chữ thường, số, '-').          Mặc định: tailmote-esp32
TS_DEVICE_NAME='tailmote-esp32'
