# =============================================================================
#  SECRETS FORM — esp32-tailscale (Phase 2 WireGuard PoC, Phase 3 Tailscale)
# =============================================================================
#  Usage (Linux/macOS: make <cmd>   |   Windows: .\tm <cmd>):
#    make secrets          # create secrets/secrets.env from this form (mode 600)
#    <edit secrets/secrets.env>
#    make config           # generate keys + peer config + sdkconfig.secrets
#
#  Rules:
#    - Put each value in single quotes '...'. To include a single quote,
#      write  '\''  (example:  'it'\''s'  ).
#    - Empty '' = use the automatic / default value noted next to the key.
#    - secrets/secrets.env must NOT be committed (it is in .gitignore).
# =============================================================================


# --- [1] Wi-Fi network the ESP32 joins (REQUIRED) -----------------------------
# 2.4 GHz only. Empty password = open network.
WIFI_SSID=''
WIFI_PASSWORD=''


# --- [2] WireGuard peer (Linux: wg-quick | Windows: WireGuard for Windows) ---
# IP/hostname the ESP32 uses to reach the peer host (UDP).
# (The LINUX_* names below are kept for compatibility; the peer may run Windows.)
# Empty = the current LAN IP of the host running `make config`.
WG_ENDPOINT=''
# WireGuard UDP port on the peer.                        Default: 51820
WG_PORT='51820'


# --- [3] Tunnel addresses -----------------------------------------------------
LINUX_TUNNEL_IP='10.66.0.1'
ESP_TUNNEL_IP='10.66.0.2'
TUNNEL_NETMASK='255.255.255.0'
TUNNEL_PREFIX='24'


# --- [4] WireGuard keys (OPTIONAL) --------------------------------------------
# Empty = generated automatically (like `wg genkey`, no wg install needed) and
# saved to secrets/*.key (kept on later runs). Fill in only to reuse an existing
# key (base64, 44 characters).
ESP_PRIVATE_KEY=''
LINUX_PRIVATE_KEY=''
# Optional preshared key for extra protection. 'auto' = generate one.
PRESHARED_KEY=''


# --- [5] Tunnel parameters ----------------------------------------------------
# Persistent keepalive (seconds, 0 = off).               Default: 25
WG_KEEPALIVE='25'
# Wi-Fi power save: 'none' (performance) | 'min_modem' (power saving)
WIFI_POWER_SAVE='none'


# --- [6] Build / flash host ---------------------------------------------------
# Board serial port (DOIT DevKit V1: CH340/CP2102), e.g. /dev/ttyUSB0 or COM7.
# Empty = auto-detect a USB-UART bridge (CH34x/CP210x/FTDI/Espressif). Set it
# when more than one adapter is plugged in; on Linux prefer /dev/serial/by-id/...
SERIAL_PORT=''
# Flash baud rate.                                       Default: 460800
FLASH_BAUD='460800'

# --- [7] Tailscale (Phase 3, firmware/phase3-tailscale) -----------------------
# Create an auth key at https://login.tailscale.com/admin/settings/keys
# (Reusable + Pre-approved recommended; add Tags if the tailnet uses tag ACLs).
# Empty = the board prints a login URL on the serial console for you to approve.
TS_AUTH_KEY=''
# Hostname on the tailnet (lowercase letters, digits, '-').  Default: tailmote-esp32
TS_DEVICE_NAME='tailmote-esp32'
# Home DERP region (relay used when no direct path exists). Empty = MicroLink's
# default (9 = Dallas). Pick the nearest: run `tailscale netcheck` on a machine
# at the same site, then look up the ID (e.g. 3 = Singapore, 20 = Hong Kong,
# 7 = Tokyo).
TS_DERP_REGION=''
