# Non-secret project settings (committed), read by scripts/tm.py.
# Any value can be overridden by an environment variable of the same name,
# e.g.  IDF_VERSION=v5.3.5 make idf   /   $env:IDF_VERSION='v5.3.5'; .\tm idf
IDF_VERSION='v5.3.6'

# Empty = per-OS default:
#   Linux/macOS: IDF_PATH=~/esp/esp-idf-<IDF_VERSION>        IDF_TOOLS_PATH=~/.espressif
#   Windows:     IDF_PATH=C:\Espressif\frameworks\esp-idf-<IDF_VERSION>  IDF_TOOLS_PATH=C:\Espressif
# ESP-IDF on Windows does not support spaces in either path.
IDF_PATH=''
IDF_TOOLS_PATH=''

IDF_TARGET='esp32'
# Firmware built/flashed by tm build/flash/monitor. Phase 2 PoC:
#   FW_PROJECT=firmware/phase2-wg-poc make build   /   $env:FW_PROJECT='firmware/phase2-wg-poc'; .	m build
FW_PROJECT='firmware/phase3-tailscale'
